{
  "name": "dsh-paper-fetcher",
  "version": "1.0.3",
  "description": "在左侧面板输入标题、DOI 或 arXiv 编号，自动下载开放获取全文并按规范命名保存。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/shared.js",
    "lib/journal.js",
    "lib/journals.json",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "literature",
    "paper",
    "pdf",
    "open-access",
    "unpaywall",
    "arxiv",
    "doi"
  ],
  "author": "朱骏 (Zhu Jun)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Usagi826/dsh-paper-fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/Usagi826/dsh-paper-fetcher/issues"
  },
  "homepage": "https://github.com/Usagi826/dsh-paper-fetcher#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  }
}
